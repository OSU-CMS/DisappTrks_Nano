universe = vanilla
executable = scripts/run_osu_pocket_coffea_job.sh
arguments = $(ProcId) $(dataset_basename) $(files_per_job) $(chunksize) $(sample) $(year) $(tag) $(x509_basename) $(job_timeout) $(category_mode) 0

output = logs/$(tag)/job_$(ClusterId).$(ProcId).out
error  = logs/$(tag)/job_$(ClusterId).$(ProcId).err
log    = logs/$(tag)/job_$(ClusterId).log

request_cpus = 1
request_memory = $(request_memory)
request_disk = $(request_disk)

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = $(transfer_inputs)
transfer_output_files = analysis_output

on_exit_remove = (ExitBySignal == False) && (ExitCode == 0)
max_retries = 3
requirements = Machine =!= LastRemoteHost

queue $(n_jobs)
